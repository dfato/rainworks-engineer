    {
      "id": "lm-ssd",
      "title": "Larynx Microphone Singer-Songwriter Dataset (LM-SSD)",
      "authors": "Simon Schwär, Michael Krause, Michael Fast, Sebastian Rosenzweig, Frank Scherbaum, Meinard Müller",
      "license": "CC BY 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "page": "https://zenodo.org/records/20287765",
      "doi": "10.5281/zenodo.20287765",
      "citation": "S. Schwär et al. A Dataset of Larynx Microphone Recordings for Singing Voice Reconstruction. TISMIR 7(1), 2024.",
      "zip": "https://zenodo.org/records/20287765/files/lm-ssd_v1.zip",
      "notes": "Popular songs sung by four amateur singers with guitar. Close-up microphone tracks without guitar crosstalk (C0), first such take per singer and song.",
      "genreSource": "ours",
      "match": {
        "regex": "^LM-SSD/audio/SSD\\d+_(?P<song>[A-Z]{2})_CM_C0_(?P<singer>\\w\\w)_T\\d\\.wav$",
        "onePer": [
          "song",
          "singer"
        ],
        "genre": "singer-songwriter"
      }
    },
    {
      "id": "albumdb",
      "title": "AlbumDB: A multitrack dataset of a ten-song album",
      "authors": "Thomas McKenzie, Eloi Moliner, Alec Wright",
      "license": "CC BY 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "page": "https://zenodo.org/records/19683001",
      "doi": "10.5281/zenodo.19683001",
      "citation": "T. McKenzie, E. Moliner, A. Wright. A multitrack dataset of a ten-song album with stereo and immersive 7.1.4 masters. AES 160th Convention, 2026. Album 'Extraordinary' by Tom McKenzie.",
      "zip": "https://zenodo.org/records/19683001/files/stems_mixed_dry.zip",
      "notes": "Lead vocal stems (mixed, no reverb or delay) of an indie rock/folk album by one singer.",
      "genreSource": "dataset",
      "match": {
        "regex": "^stems_mixed_dry/(?P<song>[^/]+)/vox_lead\\.wav$",
        "onePer": [
          "song"
        ],
        "genre": "indie"
      }
    },
    {
      "id": "vocadito",
      "title": "vocadito: A dataset of solo vocals with f0, note, and lyric annotations",
      "authors": "Rachel Bittner, Katherine Pasalo, Juan José Bosch, Gabriel Meseguer-Brocal, David Rubinstein",
      "license": "CC BY 4.0",
      "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
      "page": "https://zenodo.org/records/5578807",
      "doi": "10.5281/zenodo.5578807",
